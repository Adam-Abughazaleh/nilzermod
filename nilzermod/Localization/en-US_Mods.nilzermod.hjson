		Tooltip: This seems awfully basic for a MAGIC spear.
	}

	nursepills: {
		DisplayName: Suspicious Looking Pills
		Tooltip:
			'''
			Gain 20% bonus attack speed on all weapons
			'I don't wanna know how you got these...'
			'''
	}

	atrocity: {
