			'''
			66% chance to save ammo
			Ignores 25 points of enemy defense
			'It's raucous, it's unruly, and to be frank with you, I'm scared of this thing!'
			'''
	}

	zenithExpertAccessory: {
		DisplayName: Mighty and Magnificent Ultra-Shield of Righteousness and Glory
		Tooltip:
			'''
			It has it all! 
			'Gravity Globe not included'
			'''
	}
}

Projectiles.magicspearprojectile.DisplayName: magicspearprojectile
